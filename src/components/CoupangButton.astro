---
interface Props {
  href: string;
  label?: string;
}
const { href, label = '쿠팡에서 최저가 확인하기' } = Astro.props;
---

<a class="coupang" href={href} target="_blank" rel="sponsored nofollow noopener">
  {label}
</a>

<style>
  .coupang {
    display: block;
    text-align: center;
    padding: 0.875rem 1rem;
    margin: 1rem 0 0;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
  }
  .coupang:hover { background: var(--accent-dark); }
</style>
