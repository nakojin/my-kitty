---
import CoupangButton from './CoupangButton.astro';

interface Props {
  rank: number;
  name: string;
  price?: string;
  note?: string;
  coupangUrl?: string;
}
const { rank, name, price, note, coupangUrl } = Astro.props;
---

<section class="product">
  <h3>{rank}. {name}</h3>
  {price && <p class="price">{price}</p>}
  {note && <p>{note}</p>}
  {coupangUrl ? (
    <CoupangButton href={coupangUrl} />
  ) : (
    <p class="pending">쿠팡 링크 준비 중</p>
  )}
</section>

<style>
  .product {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .product h3 { margin-top: 0; font-size: 1.0625rem; }
  .price { font-weight: 700; color: var(--accent-dark); margin: 0.25rem 0; }
  .pending { color: var(--muted); font-size: 0.875rem; text-align: center; margin-bottom: 0; }
</style>
