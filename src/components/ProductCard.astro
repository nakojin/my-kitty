---
import CoupangButton from './CoupangButton.astro';

interface Props {
  rank: number;
  name: string;
  price?: string;
  note?: string;
  coupangUrl?: string;
}
const { rank, name, price, note, coupangUrl } = Astro.props;
---

<section class="product">
  <h3>{rank}. {name}</h3>
  {price && <p class="price">{price}</p>}
  {note && <p>{note}</p>}
  {coupangUrl ? (
    <CoupangButton href={coupangUrl} />
  ) : (
    <p class="pending">쿠팡 링크 준비 중</p>
  )}
</section>

<style>
  .product {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid #eee;
    border-radius: 10px;
  }
  .product h3 { margin-top: 0; }
  .price { font-weight: 700; color: #e5322d; }
  .pending { color: #999; font-size: 0.875rem; text-align: center; }
</style>
